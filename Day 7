File 4 — model_manager.py
This file manages model registration and selection.
from models import AIModel
from config import AVAILABLE_MODELS
from logger import logger


class ModelManager:

    def __init__(self):

        self.models = {}

        self.load_models()

    def load_models(self):

        for name, details in AVAILABLE_MODELS.items():

            model = AIModel(
                name=name,
                provider=details["provider"],
                price=details["price_per_1000_tokens"]
            )

            self.models[name] = model

        logger.info("AI models loaded successfully")

    def list_models(self):

        return list(self.models.keys())

    def get_model(self, model_name):

        model_name = model_name.lower()

        if model_name not in self.models:
            raise ValueError(f"Model {model_name} is unavailable")

        return self.models[model_name]

    def process_request(self, model_name, tokens):

        model = self.get_model(model_name)

        cost = model.calculate_cost(tokens)

        logger.info(
            "Request processed: model=%s tokens=%s cost=%s",
            model_name,
            tokens,
            cost
        )

        return {
            "model": model.name,
            "provider": model.provider,
            "tokens": tokens,
            "estimated_cost": round(cost, 6),
            "status": "success"
        }

File 5 — main.py
This is the entry point of the application.
from model_manager import ModelManager
from config import APP_NAME
from logger import logger


def main():

    print("=" * 45)
    print(APP_NAME)
    print("=" * 45)

    manager = ModelManager()

    print("\nAvailable Models:")

    for model in manager.list_models():
        print("-", model)

    model_name = input("\nSelect model: ")

    try:

        tokens = int(input("Enter token count: "))

        response = manager.process_request(
            model_name,
            tokens
        )

        print("\nRequest Result")
        print("-" * 30)

        for key, value in response.items():
            print(f"{key}: {value}")

    except (ValueError, TypeError) as error:

        logger.exception("Request failed")
        print("Error:", error)

    except Exception:

        logger.exception("Unexpected application failure")
        print("Something went wrong.")


if __name__ == "__main__":
    main()

